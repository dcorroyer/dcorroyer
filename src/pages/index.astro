---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import Layout from '../layouts/Layout.astro';

const title = 'Dylan Corroyer';
const description =
  'Web developer, six years in PHP and TypeScript. Agent-first development, DDD, TDD, self-hosted infrastructure.';

const stack = [
  { label: 'backend', items: ['PHP', 'Symfony', 'Laravel', 'API Platform'] },
  { label: 'frontend', items: ['TypeScript', 'React', 'Next.js', 'Astro.js'] },
  {
    label: 'practices',
    items: ['Agent-first', 'DDD architecture', 'TDD', 'PWA', 'Mobile-first'],
  },
  { label: 'infra', items: ['Docker', 'Self-hosted', 'Dokploy', 'Cloudflare'] },
];

// Ajoute une entrée ici (e-mail, Bluesky…) et le lien apparaît automatiquement.
// evenodd : nécessaire pour les glyphes à contre-formes, comme celui de GitHub.
const links = [
  {
    name: 'github',
    href: 'https://github.com/dcorroyer',
    evenodd: true,
    path: 'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z',
  },
  {
    name: 'linkedin',
    href: 'https://www.linkedin.com/in/dcorroyer/',
    evenodd: false,
    path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  },
];

// Cascade d'apparition, jouée une seule fois au chargement.
const step = (i: number) => `animation-delay:${i * 90}ms`;
---

<Layout title={title} description={description}>
  <main class="relative z-10 flex min-h-screen items-center justify-center px-5 py-12 sm:px-8">
    <article
      class="relative w-full max-w-2xl overflow-hidden rounded-2xl border border-line/80 bg-surface/60 shadow-2xl shadow-black/20 backdrop-blur-xl"
    >
      <!-- Filet lumineux sur l'arête supérieure -->
      <div
        aria-hidden="true"
        class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-accent/50 to-transparent"
      >
      </div>

      <header class="flex items-center justify-between border-b border-line/70 px-5 py-3 sm:px-8">
        <div class="flex items-center gap-2.5">
          <span class="status-dot"></span>
          <span class="font-mono text-xs tracking-wider text-muted">online</span>
        </div>

        <button
          id="theme-toggle"
          type="button"
          aria-label="Toggle theme"
          class="-m-2 cursor-pointer p-2 text-muted transition-colors duration-200 hover:text-fg"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 dark:hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
            ></path>
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="hidden h-4 w-4 dark:block"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
            ></path>
          </svg>
        </button>
      </header>

      <div class="px-5 py-9 sm:px-8 sm:py-12">
        <div class="rise flex items-center gap-4" style={step(0)}>
          {/* alt vide : le portrait est adjacent au nom en h1, une alternative
              textuelle la répéterait pour les lecteurs d'écran. */}
          <Image
            src={avatar}
            alt=""
            width={104}
            height={104}
            loading="eager"
            class="h-14 w-14 shrink-0 rounded-full object-cover ring-1 ring-line"
          />
          <div class="min-w-0">
            <h1 class="font-mono text-2xl font-medium tracking-tight text-fg sm:text-[1.75rem]">
              Dylan Corroyer
            </h1>
            <p class="mt-1 font-mono text-[13px] text-muted">
              web developer <span aria-hidden="true">·</span> 6 yrs
            </p>
          </div>
        </div>

        <div
          aria-hidden="true"
          class="rise my-8 h-px bg-gradient-to-r from-line via-line to-transparent"
          style={step(1)}
        >
        </div>

        <div class="rise" style={step(2)}>
          <p class="border-l-2 border-accent/60 pl-5 text-[17px] leading-relaxed text-fg sm:text-lg">
            I work <span class="font-medium text-accent">agent-first</span>: most of my development
            is driven by coding agents, on codebases I design around domain-driven design and grow
            test-first.
          </p>
          <p class="mt-6 text-[15px] leading-relaxed text-muted">
            Six years building and maintaining web applications in <span
              class="font-medium text-fg">PHP</span
            > and <span class="font-medium text-fg">TypeScript</span>, on infrastructure I host and
            run myself, behind a zero-trust edge.
          </p>
        </div>

        <dl class="rise mt-10 space-y-3.5" style={step(3)}>
          {
            stack.map((group) => (
              <div class="sm:flex sm:items-baseline sm:gap-6">
                <dt class="w-24 shrink-0 font-mono text-xs uppercase tracking-wider text-muted">
                  {group.label}
                </dt>
                <dd class="mt-1 flex flex-wrap gap-x-2 gap-y-1 text-[15px] text-fg/90 sm:mt-0">
                  {group.items.map((item, j) => (
                    <>
                      {j > 0 && (
                        <span aria-hidden="true" class="text-muted">
                          ·
                        </span>
                      )}
                      <span>{item}</span>
                    </>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>

        <div
          class="rise mt-10 flex items-center gap-5 border-t border-line/70 pt-7"
          style={step(4)}
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex cursor-pointer items-center gap-2 font-mono text-[13px] text-muted transition-colors duration-200 hover:text-accent"
              >
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    fill-rule={link.evenodd ? 'evenodd' : undefined}
                    clip-rule={link.evenodd ? 'evenodd' : undefined}
                    d={link.path}
                  />
                </svg>
                <span>{link.name}</span>
                <span
                  aria-hidden="true"
                  class="transition-transform duration-200 group-hover:translate-x-0.5"
                >
                  ↗
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </article>
  </main>
</Layout>
